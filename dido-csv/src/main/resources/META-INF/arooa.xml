<arooa:descriptor  xmlns:arooa="http://rgordon.co.uk/oddjob/arooa"
        prefix="dido" namespace="oddjob:dido">
	<conversions>
		<arooa:conversion className="dido.csv.CsvDataInBean" methodName="toStreamIn" arooaValue="true"/>
		<arooa:conversion className="dido.csv.CsvDataInBean" methodName="toMapFromString" arooaValue="true"/>
		<arooa:conversion className="dido.csv.CsvDataOutBean" methodName="toStreamOut" arooaValue="true"/>
		<arooa:conversion className="dido.csv.CsvDataOutBean" methodName="toMapToString" arooaValue="true"/>
		<arooa:conversion className="dido.csv.CsvFormatType" methodName="get" arooaValue="true"/>
	</conversions>
	<values>
		<arooa:bean-def element='csv-in'
		    className='dido.csv.CsvDataInBean'/>
		<arooa:bean-def element='csv-out'
		                className='dido.csv.CsvDataOutBean'/>
		<arooa:bean-def element='csv-format'
						className='dido.csv.CsvFormatType'>
			<properties>
				<arooa:property name="formatFrom" annotation="org.oddjob.arooa.deploy.annotations.ArooaAttribute"/>
				<arooa:property name="quoteMode" annotation="org.oddjob.arooa.deploy.annotations.ArooaAttribute"/>
			</properties>
		</arooa:bean-def>
	</values>
</arooa:descriptor>