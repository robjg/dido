<arooa:descriptor xmlns:arooa="http://rgordon.co.uk/oddjob/arooa"
                  prefix="dido" namespace="oddjob:dido">
    <conversions>
        <arooa:conversion className="dido.sql.SqlDataOutBean" methodName="toOut" arooaValue="true"/>
        <arooa:conversion className="dido.sql.SqlDataInBean" methodName="toIn" arooaValue="true"/>
    </conversions>
    <values>
        <arooa:bean-def element='sql-in'
                        className='dido.sql.SqlDataInBean'>
            <design>
                <design:form xmlns:design="arooa:design">
                    <formItems>
                        <design:group bordered="true" title="Required">
                            <formItems>
                                <design:text property="sql" title="SQL"/>
                            </formItems>
                        </design:group>
                        <design:group bordered="true" title="Optional">
                            <formItems>
                                <design:single property="schema" title="Schema"/>
                                <design:text property="batchSize" title="Batch Size"/>
                                <design:single property="classLoader" title="Class Loader"/>
                            </formItems>
                        </design:group>
                    </formItems>
                </design:form>
            </design>
        </arooa:bean-def>
        <arooa:bean-def element='sql-out'
                        className='dido.sql.SqlDataOutBean'>
            <design>
                <design:form xmlns:design="arooa:design">
                    <formItems>
                        <design:group bordered="true" title="Required">
                            <formItems>
                                <design:radio>
                                    <formItems>
                                        <design:text property="sql" title="SQL"/>
                                        <design:text property="table" title="Table"/>
                                    </formItems>
                                </design:radio>
                            </formItems>
                        </design:group>
                        <design:group bordered="true" title="Optional">
                            <formItems>
                                <design:text property="batchSize" title="Batch Size"/>
                                <design:single property="classLoader" title="Class Loader"/>
                            </formItems>
                        </design:group>
                    </formItems>
                </design:form>
            </design>
        </arooa:bean-def>
    </values>
</arooa:descriptor>