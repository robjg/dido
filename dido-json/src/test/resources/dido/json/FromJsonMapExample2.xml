<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<oddjob>
    <job>
        <bus:bus xmlns:bus="oddjob:beanbus">
            <of>
                <bus:driver>
                    <values>
                        <buffer><![CDATA[{ "Fruit":"Apple", "Qty":5, "Price":27.2 }
{ "Fruit":"Orange", "Qty":10, "Price":31.6 }
{ "Fruit":"Pear", "Qty":7, "Price":22.1 }
]]></buffer>
                    </values>
                </bus:driver>
                <dido:to-dido xmlns:dido="oddjob:dido">
                    <function>
                        <dido:json objectToNumberPolicy="LONG_OR_DOUBLE" xmlns:dido="oddjob:dido"/>
                    </function>
                </dido:to-dido>
                <dido:from-dido xmlns:dido="oddjob:dido">
                    <function>
                        <dido:json xmlns:dido="oddjob:dido"/>
                    </function>
                    <to>
                        <stdout/>
                    </to>
                </dido:from-dido>
            </of>
        </bus:bus>
    </job>
</oddjob>
